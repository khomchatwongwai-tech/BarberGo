# Server & Runtime
PORT=3000
NODE_ENV="production"
APP_MODE="production" # "demo" or "production"

# Approved Owner Identity & Vault Authentication
OWNER_ALLOWED_EMAIL="owner@wongwaigroupinc.com"
OWNER_PASSWORD_HASH="" # Modern bcrypt hash (e.g. $2a$12$...)
OWNER_DASHBOARD_TOKEN="" # High-entropy secret for emergency recovery

# Password Reset & Executive Security Delivery
RESET_EMAIL_PROVIDER="console" # "console", "resend", "sendgrid", "smtp", or "none"
RESET_EMAIL_FROM="security@wongwaigroupinc.com"
RESET_EMAIL_API_KEY="" # Server-side only email provider secret key
APP_URL="https://wongwaigroupinc.com"

# Migration Safety Override (Set true ONLY during emergency transition)
ALLOW_INSECURE_MIGRATION_PASSWORD="false"

# AI CEO Executive Analyst
GEMINI_API_KEY=""

# Product Ingestion HMAC Secrets (Signed Server-to-Server)
MARKETMIND_OPS_SECRET=""
SHIFTFORCE_OPS_SECRET=""
BARBERGO_OPS_SECRET=""

# Optional External Database Persistence (Supabase PostgreSQL)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Corporate AI Operating System — safety gates (keep false until independent certification)
WORKQORA_AUTONOMOUS_MUTATION="false"
MARKETMIND_LIVE_TRADING_ENABLED="false"

# Workqora read-only corporate connector (aggregates / health only)
WORKQORA_HEALTH_URL="https://www.workqora.com/api/health"
WORKQORA_READY_URL=""
WORKQORA_API_BASE_URL="https://www.workqora.com"
WORKQORA_DOMAIN="https://www.workqora.com"
WORKQORA_REALTIME_URL=""
WORKQORA_OPS_SECRET=""
WORKQORA_CORPORATE_SERVICE_TOKEN=""

# MarketMind trading engine (do not point at a marketing SPA)
MARKETMIND_HEALTH_URL=""
MARKETMIND_READY_URL=""
MARKETMIND_API_BASE_URL=""
MARKETMIND_DOMAIN=""
MARKETMIND_REALTIME_URL=""
MARKETMIND_OPS_SECRET=""

# Corporate upstream bounds
CORPORATE_UPSTREAM_TIMEOUT_MS="4000"
WONGWAI_HEALTH_URL="https://wongwaigroupinc.com/api/health"
