From c750d048095cf9123d4688f4b47547cd4b62b668 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sun, 30 Aug 2026 22:31:11 +0000
Subject: [PATCH] fix(automation): map late and no-show events to notify
 handlers

attendance.late and attendance.no_show already have typed notify executors.
Wire them on the vertical map and topology so Gate B is not punch-only.
Mutation stays off; notify is policy-gated the same as other low-risk alerts.
---
 server/automation/verticalEvents.ts           |  4 ++
 server/events/eventTopology.ts                |  4 +-
 tests/autonomous_operations_verticals.test.ts | 43 +++++++++++++++++++
 tests/cx3_domain_event_topology.test.ts       | 11 +++++
 4 files changed, 60 insertions(+), 2 deletions(-)

diff --git a/server/automation/verticalEvents.ts b/server/automation/verticalEvents.ts
index 06d276d..333cf0b 100644
--- a/server/automation/verticalEvents.ts
+++ b/server/automation/verticalEvents.ts
@@ -8,6 +8,8 @@ import { logWarn } from '../ops/logger.ts';
 export const VERTICAL_EVENT_ACTIONS: Record<string, { actionType: string; targetFrom: 'entityId' | 'shiftId' | 'employeeId' }> = {
   'punch.created': { actionType: 'attendance.flag_anomaly', targetFrom: 'entityId' },
   'attendance.updated': { actionType: 'attendance.flag_anomaly', targetFrom: 'entityId' },
+  'attendance.late': { actionType: 'attendance.notify_manager', targetFrom: 'employeeId' },
+  'attendance.no_show': { actionType: 'attendance.no_show_alert', targetFrom: 'employeeId' },
   'inventory.updated': { actionType: 'inventory.low_stock_alert', targetFrom: 'entityId' },
   'inventory.low': { actionType: 'inventory.low_stock_alert', targetFrom: 'entityId' },
   'inventory.count_completed': { actionType: 'inventory.flag_variance', targetFrom: 'entityId' },
@@ -73,6 +75,8 @@ export async function enqueueVerticalAutomation(input: {
           applicationId: input.event.payload.applicationId || input.event.entityId,
           employeeId: input.event.payload.employeeId || input.event.entityId,
           accountId: input.event.payload.accountId || input.event.entityId,
+          punchId: input.event.payload.punchId || (mapped.actionType.startsWith('attendance.') ? input.event.entityId : undefined),
+          shiftId: input.event.payload.shiftId || input.event.entityId,
           countId: input.event.payload.countId || input.event.entityId,
           recordId: input.event.payload.recordId || input.event.entityId,
           stepId: input.event.payload.stepId || input.event.entityId,
