     description: 'Emitted when scheduled employee fails to clock in after grace period',
   },
   {
diff --git a/tests/autonomous_operations_verticals.test.ts b/tests/autonomous_operations_verticals.test.ts
index ae57bff..bb0d384 100644
--- a/tests/autonomous_operations_verticals.test.ts
+++ b/tests/autonomous_operations_verticals.test.ts
@@ -50,6 +50,8 @@ function membership() {
 test('PR D registers vertical handlers and keeps hiring.offer unexecuted', () => {
   const registry = createProductionTypedActionRegistry();
   assert.equal(registry.hasExecutor('attendance.flag_anomaly'), true);
+  assert.equal(registry.hasExecutor('attendance.notify_manager'), true);
+  assert.equal(registry.hasExecutor('attendance.no_show_alert'), true);
   assert.equal(registry.hasExecutor('inventory.low_stock_alert'), true);
   assert.equal(registry.hasExecutor('waste.flag_variance'), true);
   assert.equal(registry.hasExecutor('equipment.create_repair_ticket'), true);
@@ -526,3 +528,44 @@ test('unknown typed vertical mapping fail-softs so the domain-event outbox can s
     delete VERTICAL_EVENT_ACTIONS['crm.task_completed'];
   }
 });
+
+test('attendance.late and attendance.no_show enqueue existing notify handlers', async () => {
+  const store = createMemoryAutomationPersistence();
+  await seedPolicy(store);
+  const registry = createProductionTypedActionRegistry();
+  const late = await enqueueVerticalAutomation({
+    event: createDomainEvent({
+      eventType: 'attendance.late',
+      organizationId: orgA,
+      locationId: locA,
+      entityId: 'punch-late-1',
+      idempotencyKey: 'attendance.late:punch-late-1',
+      payload: { employeeId: 'e-late', minutesLate: 12, body: 'Clock-in was 12 minutes late' },
+    }),
+    store,
+    registry,
+    actor: admin,
+    mutationFlagEnabled: false,
+    platformPaused: false,
+  });
+  assert.equal(late.execution?.actionType, 'attendance.notify_manager');
+  assert.notEqual(late.execution?.status, 'failed');
+
+  const noShow = await enqueueVerticalAutomation({
+    event: createDomainEvent({
+      eventType: 'attendance.no_show',
+      organizationId: orgA,
+      locationId: locA,
+      entityId: 'shift-miss-1',
+      idempotencyKey: 'attendance.no_show:shift-miss-1',
+      payload: { employeeId: 'e-noshow', shiftId: 'shift-miss-1', body: 'No-show after grace period' },
+    }),
+    store,
+    registry,
+    actor: admin,
+    mutationFlagEnabled: false,
+    platformPaused: false,
+  });
+  assert.equal(noShow.execution?.actionType, 'attendance.no_show_alert');
+  assert.notEqual(noShow.execution?.status, 'failed');
+});
diff --git a/tests/cx3_domain_event_topology.test.ts b/tests/cx3_domain_event_topology.test.ts
index e3c81a0..fbb8c0a 100644
--- a/tests/cx3_domain_event_topology.test.ts
+++ b/tests/cx3_domain_event_topology.test.ts
@@ -86,12 +86,23 @@ describe('AG-CX3 Canonical Event Topology', () => {
     assert.ok(invLowConsumers.includes(DOMAIN_EVENT_CONSUMERS.metricsInvalidation));
     assert.ok(invLowConsumers.includes(DOMAIN_EVENT_CONSUMERS.workflowEngine));
     assert.ok(invLowConsumers.includes(DOMAIN_EVENT_CONSUMERS.automationVertical));
+
+    const lateConsumers = consumersForEvent('attendance.late');
+    assert.ok(lateConsumers.includes(DOMAIN_EVENT_CONSUMERS.workflowEngine));
+    assert.ok(lateConsumers.includes(DOMAIN_EVENT_CONSUMERS.automationVertical));
+    const noShowConsumers = consumersForEvent('attendance.no_show');
+    assert.ok(noShowConsumers.includes(DOMAIN_EVENT_CONSUMERS.automationVertical));
   });
 
   it('maps vertical automation actions accurately without gaps', () => {
     assert.equal(isVerticalMappedEvent('punch.created'), true);
     assert.equal(verticalActionForEvent('punch.created')?.actionType, 'attendance.flag_anomaly');
 
+    assert.equal(isVerticalMappedEvent('attendance.late'), true);
+    assert.equal(verticalActionForEvent('attendance.late')?.actionType, 'attendance.notify_manager');
+    assert.equal(isVerticalMappedEvent('attendance.no_show'), true);
+    assert.equal(verticalActionForEvent('attendance.no_show')?.actionType, 'attendance.no_show_alert');
+
     assert.equal(isVerticalMappedEvent('inventory.low'), true);
     assert.equal(verticalActionForEvent('inventory.low')?.actionType, 'inventory.low_stock_alert');
 
