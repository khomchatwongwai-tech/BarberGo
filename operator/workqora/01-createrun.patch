+test("createRun degrades gracefully when AG versioning columns are not applied yet", async () => {
+  const wf = workflowDefRow({ trigger_event_type: "employee.activated" });
+  const sb = seedEngineSupabase([wf], {
+    missingColumns: { workflow_runs: ["definition_version", "workflow_version_id", "state_transitions"] },
+  });
+  const event = makeEvent({ correlationId: "corr-ag", causationId: null });
+  const outcome = await processWorkflowEvent(sb, event);
+  assert.equal(outcome.runsStarted, 1, "runs must still start when 20260943000000 is not applied");
+  const run = (sb._tables.get("workflow_runs") || [])[0];
+  assert.equal(run.status, "completed");
+  assert.equal(run.correlation_id, "corr-ag");
+  assert.equal(run.definition_version, undefined);
+});
+
+test("createRun still starts when both AG versioning and correlation columns are missing", async () => {
+  const wf = workflowDefRow({ trigger_event_type: "employee.activated" });
+  const sb = seedEngineSupabase([wf], {
+    missingColumns: {
+      workflow_runs: ["definition_version", "workflow_version_id", "state_transitions", "correlation_id", "causation_id"],
+    },
+  });
+  const outcome = await processWorkflowEvent(sb, makeEvent());
+  assert.equal(outcome.runsStarted, 1);
+  const run = (sb._tables.get("workflow_runs") || [])[0];
+  assert.equal(run.status, "completed");
+  assert.equal(run.definition_version, undefined);
+  assert.equal(run.correlation_id, undefined);
+});
+
+test("cancelWorkflowRun still writes CANCELLED when state_transitions is not in the schema", async () => {
+  const wf = workflowDefRow({ trigger_event_type: "employee.activated" });
+  const sb = seedEngineSupabase([wf], {
+    missingColumns: { workflow_runs: ["definition_version", "workflow_version_id", "state_transitions"] },
+  });
+  const event = makeEvent();
+  await processWorkflowEvent(sb, event);
+  const run = (sb._tables.get("workflow_runs") || [])[0];
+  run.status = "running";
+  run.completed_at = null;
+  const cancelled = await cancelWorkflowRun(sb, run.id, "operator-1", "stop");
+  assert.equal(cancelled.status, "ok");
+  assert.equal(run.status, "CANCELLED");
+  assert.equal(run.state_transitions, undefined);
+});
