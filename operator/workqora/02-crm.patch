-        body: typeof input.event.payload.body === 'string' ? input.event.payload.body : 'Automation notice',
+  try {
+    const execution = await processAutonomousProposal({
+      store: input.store,
+      registry: input.registry,
+      actor: input.actor,
+      proposal: {
+        organizationId: input.actor.organizationId,
+        locationId: input.event.locationId,
+        actionType: mapped.actionType,
+        triggerEventId: input.event.id,
+        correlationId: input.event.idempotencyKey,
+        targetId,
+        payload: {
+          ...input.event.payload,
+          itemId: input.event.payload.itemId || input.event.entityId,
+          equipmentId: input.event.payload.equipmentId || input.event.entityId,
+          ticketId: input.event.payload.ticketId || input.event.entityId,
+          assignmentId: input.event.payload.assignmentId || input.event.entityId,
+          applicationId: input.event.payload.applicationId || input.event.entityId,
+          employeeId: input.event.payload.employeeId || input.event.entityId,
+          accountId: input.event.payload.accountId || input.event.entityId,
+          countId: input.event.payload.countId || input.event.entityId,
+          recordId: input.event.payload.recordId || input.event.entityId,
+          stepId: input.event.payload.stepId || input.event.entityId,
+          body: typeof input.event.payload.body === 'string' ? input.event.payload.body : 'Automation notice',
+        },
       },
-    },
-    mutationFlagEnabled: input.mutationFlagEnabled,
-    platformPaused: input.platformPaused,
-  });
-  return { enqueued: execution.status === 'pending', reason: execution.status, execution };
+      mutationFlagEnabled: input.mutationFlagEnabled,
+      platformPaused: input.platformPaused,
+    });
+    return { enqueued: execution.status === 'pending', reason: execution.status, execution };
+  } catch (error) {
+    if (error instanceof AutomationAuthorizationError && error.code === 'UNKNOWN_ACTION') {
+      logWarn('automation.vertical_unknown_action', {
+        organizationId: input.event.organizationId,
+        errorCategory: 'UNKNOWN_ACTION',
