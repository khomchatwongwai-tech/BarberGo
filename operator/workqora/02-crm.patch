+
+test('CRM follow-up and risk verticals enqueue notify-only handlers without CRM table writes', async () => {
+  const store = createMemoryAutomationPersistence();
+  await seedPolicy(store);
+  const registry = createProductionTypedActionRegistry();
+  const follow = await enqueueVerticalAutomation({
+    event: createDomainEvent({
+      eventType: 'crm.followup_due',
+      organizationId: orgA,
+      locationId: locA,
+      entityId: 'crm_tsk_1',
+      idempotencyKey: 'crm.followup_due:crm_tsk_1',
+      payload: { accountId: 'crm_acc_1', title: 'Quarterly Review', body: 'Follow up is due' },
+    }),
+    store,
+    registry,
+    actor: admin,
+    mutationFlagEnabled: false,
+    platformPaused: false,
+  });
+  assert.equal(follow.execution?.actionType, 'crm.follow_up');
+  assert.notEqual(follow.execution?.status, 'failed');
+
+  const risk = await enqueueVerticalAutomation({
+    event: createDomainEvent({
+      eventType: 'crm.risk_detected',
+      organizationId: orgA,
+      locationId: locA,
+      entityId: 'crm_acc_1',
+      idempotencyKey: 'crm.risk_detected:crm_acc_1',
+      payload: { healthScore: 30, body: 'Account is at risk' },
+    }),
+    store,
+    registry,
+    actor: admin,
+    mutationFlagEnabled: false,
+    platformPaused: false,
+  });
+  assert.equal(risk.execution?.actionType, 'crm.escalate_risk');
+  assert.notEqual(risk.execution?.status, 'failed');
+});
+
+test('unknown typed vertical mapping fail-softs so the domain-event outbox can still process', async () => {
+  const store = createMemoryAutomationPersistence();
+  await seedPolicy(store);
+  const registry = createProductionTypedActionRegistry();
+  VERTICAL_EVENT_ACTIONS['crm.task_completed'] = { actionType: 'crm.does_not_exist', targetFrom: 'entityId' };
+  try {
+    const result = await enqueueVerticalAutomation({
+      event: createDomainEvent({
+        eventType: 'crm.task_completed',
+        organizationId: orgA,
+        locationId: locA,
+        entityId: 'crm_tsk_done',
+        idempotencyKey: 'crm.task_completed:crm_tsk_done',
+        payload: {},
+      }),
+      store,
+      registry,
+      actor: admin,
+      mutationFlagEnabled: false,
+      platformPaused: false,
+    });
+    assert.equal(result.enqueued, false);
+    assert.equal(result.reason, 'unknown_typed_action');
+  } finally {
+    delete VERTICAL_EVENT_ACTIONS['crm.task_completed'];
+  }
+});
