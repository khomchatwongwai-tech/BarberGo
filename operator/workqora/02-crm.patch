@@ -59,6 +59,8 @@ export function registerVerticalActionHandlers(
   registry.register(onboardingAssignHandler(ports));
   registry.register(onboardingRemindHandler(ports));
   registry.register(notifyManagerHandler(ports, 'onboarding.notify_manager', 'Onboarding notice'));
+  registry.register(notifyManagerHandler(ports, 'crm.follow_up', 'CRM follow-up due'));
+  registry.register(notifyManagerHandler(ports, 'crm.escalate_risk', 'CRM account at risk'));
   registry.register(managerSummaryHandler(ports));
   registry.register(periodReportHandler(ports, 'reports.generate_weekly', 'weekly'));
   registry.register(periodReportHandler(ports, 'reports.generate_monthly', 'monthly'));
