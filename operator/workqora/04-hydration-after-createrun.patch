+
+function stringFact(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const trimmed = value.trim();
+  return trimmed ? trimmed : null;
+}
+
+function missingFact(value: unknown): boolean {
+  return value === undefined || value === null || value === "";
+}
+
+function isTimeOffEvent(eventType: string): boolean {
+  return eventType.startsWith("timeoff.") || eventType.startsWith("time_off.");
+}
+
+function isShiftSwapEvent(eventType: string): boolean {
+  return eventType === "shift.swap_requested"
+    || eventType === "shift.swap_approved"
+    || eventType === "shift.swap_rejected";
+}
+
+function isCertificateEvent(eventType: string): boolean {
+  return eventType === "certificate.expiring" || eventType === "certificate.expired";
+}
+
+function isInventoryEvent(eventType: string): boolean {
+  return eventType === "inventory.updated" || eventType === "inventory.low";
+}
+
+function isRepairTicketEvent(eventType: string): boolean {
+  return eventType === "maintenance.created" || eventType === "equipment.issue_reported";
+}
+
+function isWasteEvent(eventType: string): boolean {
+  return eventType === "waste.recorded" || eventType === "waste.threshold_exceeded";
+}
+
+/** Fill location / coverage / swap facts from the source request row when the
+ * live enqueue trigger has not yet been replaced by 20260944000000.
+ * Tenant-scoped. Does not invent swapRole or conflictCount. */
+export async function hydrateWorkflowDomainEvent(
+  sb: Pick<SupabaseClient, "from">,
+  event: DomainEvent,
+): Promise<DomainEvent> {
+  const payload: Record<string, unknown> = { ...(event.payload || {}) };
+  let locationId = stringFact(event.locationId) || stringFact(payload.locationId) || stringFact(payload.location_id);
+  const timeOff = isTimeOffEvent(event.eventType);
+  const swap = isShiftSwapEvent(event.eventType);
+  const certificate = isCertificateEvent(event.eventType);
+  const needsSourceRow = Boolean(
+    event.entityId
+    && event.organizationId
+    && (timeOff || swap)
+    && (!locationId || (timeOff && missingFact(payload.conflictCount)) || (swap && missingFact(payload.swapRole))),
+  );
+
+  if (needsSourceRow) {
+    const table = timeOff ? "time_off_requests" : "shift_swap_requests";
+    const { data } = await sb
+      .from(table)
+      .select("payload")
+      .eq("id", event.entityId)
+      .eq("organization_id", event.organizationId)
+      .maybeSingle();
+    const source = data?.payload && typeof data.payload === "object" && !Array.isArray(data.payload)
+      ? data.payload as Record<string, unknown>
+      : {};
+    const facts = pickWorkflowEventPayload(table, source);
+    for (const [key, value] of Object.entries(facts)) {
+      if (key === "resource") continue;
+      if (missingFact(payload[key])) payload[key] = value;
+    }
+    locationId = locationId || stringFact(source.locationId) || stringFact(source.location_id);
+  }
+
+  if (
+    certificate
+    && event.entityId
+    && event.organizationId
+    && (missingFact(payload.daysUntilExpiration) || missingFact(payload.employeeId))
+  ) {
+    const { data } = await sb
+      .from("employee_certifications")
+      .select("employee_id, expiration_date, certification_type")
+      .eq("id", event.entityId)
+      .eq("organization_id", event.organizationId)
+      .maybeSingle();
+    if (data) {
+      const facts = pickWorkflowEventPayload("employee_certifications", {
+        employeeId: data.employee_id,
+        expirationDate: data.expiration_date,
+        certificationType: data.certification_type,
+        daysUntilExpiration: daysUntilDate(typeof data.expiration_date === "string" ? data.expiration_date : null),
+      });
+      for (const [key, value] of Object.entries(facts)) {
+        if (key === "resource") continue;
+        if (missingFact(payload[key])) payload[key] = value;
+      }
+    }
+  }
+
+  if (
+    isInventoryEvent(event.eventType)
+    && event.entityId
+    && event.organizationId
+    && (missingFact(payload.quantity) || missingFact(payload.reorderPoint))
+  ) {
+    const { data } = await sb
+      .from("inventory_items")
+      .select("quantity_on_hand, reorder_point, par_level, location_id, name")
+      .eq("id", event.entityId)
+      .eq("organization_id", event.organizationId)
+      .maybeSingle();
+    if (data) {
+      const reorder = data.reorder_point ?? data.par_level;
+      const facts = pickWorkflowEventPayload("inventory_items", {
+        quantity: data.quantity_on_hand,
+        reorderPoint: reorder,
+        itemName: data.name,
+        itemId: event.entityId,
+        locationId: data.location_id,
+      });
+      for (const [key, value] of Object.entries(facts)) {
+        if (key === "resource") continue;
+        if (missingFact(payload[key])) payload[key] = value;
+      }
+      locationId = locationId || stringFact(data.location_id);
+    }
+  }
+
+  if (
+    isRepairTicketEvent(event.eventType)
+    && event.entityId
+    && event.organizationId
+    && (missingFact(payload.priority) || missingFact(payload.ticketId) || missingFact(payload.equipmentId))
+  ) {
+    const { data } = await sb
+      .from("equipment_repair_tickets")
+      .select("id, equipment_id, location_id, priority, equipment_name")
+      .eq("id", event.entityId)
+      .eq("organization_id", event.organizationId)
+      .maybeSingle();
+    if (data) {
+      const facts = pickWorkflowEventPayload("equipment_repair_tickets", {
+        ticketId: data.id,
+        equipmentId: data.equipment_id,
+        itemId: data.equipment_id,
+        itemName: data.equipment_name,
+        priority: data.priority,
+        locationId: data.location_id,
+      });
+      for (const [key, value] of Object.entries(facts)) {
+        if (key === "resource") continue;
+        if (missingFact(payload[key])) payload[key] = value;
+      }
+      locationId = locationId || stringFact(data.location_id);
+    }
+  }
+
+  if (
+    isWasteEvent(event.eventType)
+    && event.entityId
+    && event.organizationId
+    && (missingFact(payload.quantity) || missingFact(payload.itemId))
+  ) {
+    const { data } = await sb
+      .from("waste_records")
+      .select("quantity_wasted, item_id, item_name, location_id")
+      .eq("id", event.entityId)
+      .eq("organization_id", event.organizationId)
+      .maybeSingle();
+    if (data) {
+      const facts = pickWorkflowEventPayload("waste_records", {
+        quantity: data.quantity_wasted,
+        itemId: data.item_id,
+        itemName: data.item_name,
+        locationId: data.location_id,
+      });
+      for (const [key, value] of Object.entries(facts)) {
+        if (key === "resource") continue;
+        if (missingFact(payload[key])) payload[key] = value;
+      }
+      locationId = locationId || stringFact(data.location_id);
+    }
+  }
+
+  return { ...event, locationId, payload };
+}
